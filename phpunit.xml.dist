<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="./phpunit.php" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd">
  <coverage processUncoveredFiles="true">
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </coverage>
  <testsuites>
    <testsuite name="Aura.Filter test suite">
      <directory>./tests</directory>
      <exclude>./tests/Rule/Sanitize/AbstractSanitizeTest.php</exclude>
      <exclude>./tests/Rule/Validate/AbstractValidateTest.php</exclude>
    </testsuite>
  </testsuites>
</phpunit>
