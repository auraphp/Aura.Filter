<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="./phpunit.php" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd">
  <testsuites>
    <testsuite name="Aura.Filter test suite">
      <directory>./tests</directory>
      <exclude>./tests/Rule/Sanitize/AbstractSanitizeTest.php</exclude>
      <exclude>./tests/Rule/Validate/AbstractValidateTest.php</exclude>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
</phpunit>
